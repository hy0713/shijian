# Required for real research. Select a model with tool calls and function-calling structured output.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
# deepseek (default), tavily, or wikisource (site-limited).
SEARCH_PROVIDER=deepseek
DEEPSEEK_TOOLS_BASE_URL=https://api.deepseek.com
# Optional separate tool key; blank reuses DEEPSEEK_API_KEY. Chat Base URL is not reused.
DEEPSEEK_TOOLS_API_KEY=
# Optional estimates from official Chinese pricing checked 2026-10-20. Remove to disable estimates.
SEARCH_PRICE_CNY_PER_1000=5
FETCH_PRICE_CNY_PER_1000=5
MAX_WEB_SEARCHES=3
EVALUATION_DIR=data/evaluations
# Optional alternative: required only when SEARCH_PROVIDER=tavily.
SEARCH_API_KEY=
SEARCH_API_URL=https://api.tavily.com/search
# Host CLI defaults; Compose overrides hostnames internally.
DATABASE_URL=mysql+pymysql://shijian:shijian_local@localhost:3306/shijian?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0
MILVUS_URI=http://localhost:19530
MYSQL_PASSWORD=shijian_local
MYSQL_ROOT_PASSWORD=change_local_root
MINIO_ROOT_USER=shijianminio
MINIO_ROOT_PASSWORD=change_local_minio
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
EMBEDDING_DIMENSION=512
EMBEDDING_DEVICE=cpu
MODEL_CACHE=data/cache/models
# Set to 1 only after the configured model is fully downloaded into this environment's cache.
HF_HUB_OFFLINE=0
MILVUS_COLLECTION=shijian_bge_small_zh_v1
MAX_ROUNDS=4
MAX_TOOL_CALLS=16
MAX_WEB_PAGES=4
MAX_EVIDENCE=24
# All model stages and format repair count toward this per-task request limit.
MAX_MODEL_REQUESTS=16
# Checked before each request; the in-flight response may exceed this observed-token threshold.
# This is not a currency cap and does not include other tasks or other programs using the key.
MAX_MODEL_TOKENS=60000
RESEARCH_TIMEOUT=240
REQUEST_TIMEOUT=30
FETCH_MAX_BYTES=2000000
LEASE_SECONDS=120
HEARTBEAT_SECONDS=15
